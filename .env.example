# Reference environment variables used by the maintained configs.
# Keep secrets here (or in your shell), while benchmark/configs/*.yaml
# remains the public, reproducible configuration layer.

# GitHub access for release-note collection.
GITHUB_TOKEN=your_github_token
GH_TOKEN=

# LLM and embedding services used by the maintained pipeline.
DEEPSEEK_API_KEY=your_deepseek_api_key
SILICONFLOW_API_KEY=your_siliconflow_api_key

# Local Neo4j password for Graphiti experiments.
GRAPHITI_NEO4J_PASSWORD=your_neo4j_password